rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return signedIn() && currentUserData().role == 'teacher';
    }

    function essayData(essayId) {
      return get(/databases/$(database)/documents/essays/$(essayId)).data;
    }

    function isEssayOwner(essayId) {
      return signedIn() && essayData(essayId).studentId == request.auth.uid;
    }

    function isAssignedReviewer(essayId) {
      return signedIn() &&
        essayData(essayId).peerReviewIds != null &&
        request.auth.uid in essayData(essayId).peerReviewIds;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      // Allow teachers to delete student accounts for the complete wipe feature
      allow delete: if request.auth != null && (
        request.auth.uid == userId || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
      );
    }
    
    // Essays collection
    match /essays/{essayId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null; // owner OR teacher (role enforced in app)

      match /discussion/{commentId} {
        allow read: if signedIn() && (
          isEssayOwner(essayId) ||
          isAssignedReviewer(essayId) ||
          isTeacher()
        );
        allow create, update, delete: if false;
      }
    }

    match /reviewDiscussionThreads/{threadId} {
      allow read: if signedIn() && (
        isEssayOwner(resource.data.essayId) ||
        isAssignedReviewer(resource.data.essayId) ||
        isTeacher()
      );

      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'essayId',
          'reviewerId',
          'createdAt',
          'lastCommentAt',
          'commentCount'
        ]) &&
        (
          isEssayOwner(request.resource.data.essayId) ||
          isAssignedReviewer(request.resource.data.essayId) ||
          isTeacher()
        );

      allow update: if signedIn() &&
        request.resource.data.essayId == resource.data.essayId &&
        request.resource.data.reviewerId == resource.data.reviewerId &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'lastCommentAt',
          'commentCount'
        ]) &&
        (
          isEssayOwner(resource.data.essayId) ||
          isAssignedReviewer(resource.data.essayId) ||
          isTeacher()
        );

      allow delete: if false;

      match /comments/{commentId} {
        allow read: if signedIn() && (
          isEssayOwner(resource.data.essayId) ||
          isAssignedReviewer(resource.data.essayId) ||
          isTeacher()
        );

        allow create: if signedIn() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.keys().hasOnly([
            'essayId',
            'reviewerId',
            'authorId',
            'text',
            'createdAt'
          ]) &&
          (
            isEssayOwner(request.resource.data.essayId) ||
            isAssignedReviewer(request.resource.data.essayId) ||
            isTeacher()
          );

        allow update, delete: if false;
      }
    }

    match /essayAnnotations/{annotationId} {
      allow read: if signedIn() && (
        isEssayOwner(resource.data.essayId) ||
        isAssignedReviewer(resource.data.essayId) ||
        isTeacher()
      );

      allow create: if signedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        (
          (request.resource.data.authorRole == 'teacher' && isTeacher()) ||
          (
            request.resource.data.authorRole == 'student' &&
            !isEssayOwner(request.resource.data.essayId) &&
            isAssignedReviewer(request.resource.data.essayId)
          )
        );

      allow update: if signedIn() && (
        (
          resource.data.authorId == request.auth.uid &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.essayId == resource.data.essayId &&
          request.resource.data.authorRole == resource.data.authorRole &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'note',
            'updatedAt'
          ])
        ) ||
        isTeacher()
      );

      allow delete: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        isTeacher()
      );
    }
    
    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if signedIn() && (
        resource.data.reviewerId == request.auth.uid ||
        isEssayOwner(resource.data.essayId) ||
        isAssignedReviewer(resource.data.essayId) ||
        isTeacher()
      );

      allow create: if signedIn() && (
        request.resource.data.reviewerRole == 'ai' ||
        (
          request.resource.data.reviewerId == request.auth.uid &&
          (
            (request.resource.data.reviewerRole == 'teacher' && isTeacher()) ||
            (
              (request.resource.data.reviewerRole == null || request.resource.data.reviewerRole == 'student') &&
              !isEssayOwner(request.resource.data.essayId) &&
              isAssignedReviewer(request.resource.data.essayId)
            )
          )
        )
      );

      allow update: if signedIn() && (
        (
          resource.data.reviewerId == request.auth.uid &&
          request.resource.data.reviewerId == resource.data.reviewerId &&
          request.resource.data.essayId == resource.data.essayId &&
          request.resource.data.reviewerRole == resource.data.reviewerRole &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'scores',
            'totalScore',
            'overallBand',
            'feedback',
            'annotations',
            'annotationsCount',
            'annotationSchemaVersion',
            'updatedAt',
            'completedAt',
            'reviewerName',
            'dimensions',
            'topActions'
          ])
        ) ||
        (
          isEssayOwner(resource.data.essayId) &&
          request.resource.data.reviewerId == resource.data.reviewerId &&
          request.resource.data.essayId == resource.data.essayId &&
          request.resource.data.reviewerRole == resource.data.reviewerRole &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'studentRating',
            'studentResponse'
          ])
        )
      );

      allow delete: if signedIn() && (
        resource.data.reviewerId == request.auth.uid ||
        isTeacher()
      );
    }

    // Assistant Chats collection — teachers can read and write their own chat histories
    match /assistantChats/{chatId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Topics collection — teachers write, all authenticated users read
    match /topics/{topicId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Messages collection — teachers create, all authenticated users read/update (mark as read)
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;

      // Student & teacher replies subcollection
      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && resource.data.studentId == request.auth.uid;
      }
    }

    // Telegram temporary link codes (created by client with auth)
    match /telegram_links/{linkId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Allow the owner to read their own link
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      // Allow unauthenticated reads so the webhook API route can look up a code
      allow read: if true;
    }

    // Telegram verified — written by the webhook (no auth), read+deleted by the client once linked
    match /telegram_verified/{docId} {
      // Webhook writes here (no auth token) after a valid /start command
      allow create: if true;
      // Client reads and deletes after linking (the random code acts as the capability token)
      allow read, delete: if true;
    }
    // Batch jobs — created/read by teachers via the scheduler
    match /batchJobs/{jobId} {
      allow read, create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Scheduled tasks and exports - teachers manage automation entries from the app
    match /scheduledTasks/{taskId} {
      allow read, create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    match /schedulerExports/{exportId} {
      allow read, create, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
      allow update: if false;
    }

    match /progressReports/{reportId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Settings collection — teachers write, all authenticated users read
    // (used for EVA access control: settings/eva)
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // AI Detection Logs — written by students (authenticated) when AI content is detected,
    // read only by teachers
    match /ai_detection_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
      allow update, delete: if false;
    }
  }
}
